from flask import Flask, send_from_directory, jsonify, redirect, request
import subprocess
import os
import json
import html


BASE_FOLDER = "/home/avenigalla/pophealth_flask"
STATIC_FOLDER = "/home/avenigalla/pophealth_flask/static"
PYTHON_EXE = os.path.join(BASE_FOLDER, "venv", "bin", "python")

app = Flask(__name__)


def clean_username(username):
    username = str(username or "").strip()
    username = username.split("\\")[-1]
    username = username.split("/")[-1]
    username = username.split("@")[0]
    username = username.lower()
    return username


def get_current_username():
    username = (
        request.headers.get("X-Remote-User")
        or request.headers.get("X-Remote-Name")
        or request.headers.get("X-Forwarded-User")
        or request.headers.get("X-Authenticated-User")
        or request.headers.get("Remote-User")
        or request.environ.get("REMOTE_USER")
        or ""
    )

    return clean_username(username)


def serve_index_file(use_pophealth_base=False):
    index_path = os.path.join(STATIC_FOLDER, "index.html")

    if not os.path.exists(index_path):
        return "<h1>Pophealth dashboard unavailable.</h1>", 404

    with open(index_path, "r", encoding="utf-8") as file:
        page = file.read()

    username = get_current_username()
    escaped_username = html.escape(username, quote=True)
    json_username = json.dumps(username)

    injected_code = f"""
<meta name="current-user" content="{escaped_username}">
<script>
    window.CURRENT_USER = {json_username};
</script>
"""

    if use_pophealth_base:
        page = page.replace("<head>", "<head>\n<base href=\"/pophealth/\">", 1)

    page = page.replace("</head>", injected_code + "\n</head>", 1)

    return page


@app.route("/")
def root_index():
    return serve_index_file(use_pophealth_base=False)


@app.route("/pophealth")
def pophealth_no_slash():
    return redirect("/pophealth/")


@app.route("/pophealth/")
def pophealth_index():
    return serve_index_file(use_pophealth_base=True)


@app.route("/debug-user")
@app.route("/pophealth/debug-user")
def debug_user():
    return jsonify({
        "username": get_current_username(),
        "remote_user": request.environ.get("REMOTE_USER"),
        "x_remote_user": request.headers.get("X-Remote-User"),
        "x_remote_name": request.headers.get("X-Remote-Name"),
        "x_forwarded_user": request.headers.get("X-Forwarded-User"),
        "x_authenticated_user": request.headers.get("X-Authenticated-User"),
        "all_headers": dict(request.headers)
    })


@app.route("/refresh")
@app.route("/pophealth/refresh")
def refresh():
    result = subprocess.run(
        [PYTHON_EXE, os.path.join(BASE_FOLDER, "analysis.py")],
        cwd=BASE_FOLDER,
        capture_output=True,
        text=True
    )

    if result.returncode != 0:
        return jsonify({
            "status": "error",
            "stdout": result.stdout,
            "stderr": result.stderr
        }), 500

    return jsonify({
        "status": "refreshed",
        "stdout": result.stdout
    })


@app.route("/health")
@app.route("/pophealth/health")
def health():
    return jsonify({"status": "ok"})


@app.route("/pophealth/<path:filename>")
def pophealth_static_files(filename):
    return send_from_directory(STATIC_FOLDER, filename)


@app.route("/<path:filename>")
def root_static_files(filename):
    return send_from_directory(STATIC_FOLDER, filename)


if __name__ == "__main__":
    app.run(host="0.0.0.0", port=5000) # change later for own debugging to 5001